#!/bin/bash
# Git pre-push hook — 推送前自动上传到 OSS
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
cd "$PROJECT_DIR"

# 从 .oss_credentials 加载凭证
if [ -f .oss_credentials ]; then
  export OSS_ACCESS_KEY_ID="$(grep ACCESS_KEY= .oss_credentials | head -1 | cut -d= -f2)"
  export OSS_ACCESS_KEY_SECRET="$(grep ACCESS_SECRET= .oss_credentials | cut -d= -f2)"
fi

ENDPOINT="oss-cn-beijing.aliyuncs.com"
REGION="cn-beijing"
BUCKET="oss://fdty"

# 不同分支上传到不同文件夹，feat/xxx → feat-xxx
BRANCH="$(git branch --show-current | tr '/' '-')"
PREFIX="$BUCKET/$BRANCH"

echo "[oss] uploading to $PREFIX/ ..."
./bin/ossutil cp fdty_top.js "$PREFIX/" -e "$ENDPOINT" --region "$REGION" -f
echo "[oss] done"
